# Copia este archivo a .env y ajusta los valores. .env nunca se versiona
# (ver .gitignore) — solo esta plantilla.

# Ruta al archivo COCO a validar (JSON exportado desde /export/coco).
DATASET_QUALITY_COCO_SOURCE_PATH=/path/to/dataset.json

# Ruta al archivo de política de calidad. Por defecto usa el que vive junto
# a pyproject.toml.
DATASET_QUALITY_QUALITY_CONFIG_PATH=quality.yaml

# Carpeta donde se escriben quality.json, splits y demás artefactos.
DATASET_QUALITY_OUTPUT_DIR=output
