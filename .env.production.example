# ── App - Production
NODE_ENV=production
PORT=3100

# ── Database (MariaDB)
DATABASE_URL=mysql://user:password@db-host:3306/image_repo

DB_HOST=db-host
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=image_repo

# ── Object Storage (AWS S3 mediante el rol IAM de la tarea)
STORAGE_PROVIDER=s3
AWS_REGION=us-east-2
S3_BUCKET=proyecto2-prod-images-ACCOUNT_ID

# Tamaño máximo permitido por imagen: 5 MB.
MAX_UPLOAD_SIZE_BYTES=5242880
